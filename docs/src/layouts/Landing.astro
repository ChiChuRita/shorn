---
import "starlight-theme-next/fonts/geist-sans/index.css";
// `index.css` ships weight 400 only. Every `font-weight: 500` below (headline,
// brand, button, section headings) silently rendered as regular without this.
import "starlight-theme-next/fonts/geist-sans/500.css";
import "starlight-theme-next/fonts/geist-mono/index.css";
// The same palette Starlight loads through customCss. This page renders outside
// the Starlight shell, so it has to ask for the tokens itself.
import "../styles/tokens.css";
import { structuredData } from "../lib/agent-metadata";
// The docs' own code block: the same expressive-code renderer, theme, and contrast
// correction as every snippet in the docs, so the landing page's code is coloured
// exactly like theirs rather than by a second highlighter configured to look alike.
import { Code } from "@astrojs/starlight/components";

/**
 * The minimalist landing shell, extracted so the message can vary without the
 * surface varying with it. One nav, one headline, one sentence, one primary
 * action, one footer line. A variant supplies text, never new elements.
 *
 * `size` exists because the one typographic moment has to survive a longer
 * headline. It trades scale for character count rather than letting a long
 * headline wrap to four lines at 208px.
 */
interface Props {
  title: string;
  description: string;
  headline: string;
  /** xl ≤ 12 chars · lg ≤ 34 · md for anything longer. */
  size?: "xl" | "lg" | "md";
  cta?: string;
  /** Optional demonstration block. One element, not a section. See below. */
  code?: readonly string[];
}

const { title, description, headline, size = "lg", cta = "Get started", code } = Astro.props;


// Astro's BASE_URL carries the configured `base` ("/shorn") with a trailing
// slash. Strip it so the helper below never emits a doubled separator.
const root = import.meta.env.BASE_URL.replace(/\/$/, "");
const p = (slug: string) => `${root}/${slug}`;

const install = "npm install @chichurita/shorn";

// Absolute, because og:image is the one URL crawlers will not resolve relatively.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${root}/og.png`, Astro.site);

// The machine-readable identity of the project, for readers that will not infer it from
// the prose. Only the landing page carries it: it describes shorn, not this page.
const jsonLd = JSON.stringify(structuredData(Astro.site?.origin));
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={p("favicon.svg")} type="image/svg+xml" />
    <link rel="alternate" type="text/markdown" href={p("llms.txt")} title="LLMs.txt" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </head>

  <body>
    <header>
      <a class="brand" href={p("")}>
        <svg viewBox="0 0 64 64" width="20" height="20" aria-hidden="true">
          <rect
            x="7"
            y="14"
            width="50"
            height="13"
            rx="4"
            fill="none"
            stroke="currentColor"
            stroke-width="4"></rect>
          <rect x="7" y="37" width="18" height="13" rx="4" fill="currentColor"></rect>
        </svg>
        shorn
      </a>
      <nav>
        <a href={p("getting-started/introduction/")}>Docs</a>
        <a href="https://github.com/ChiChuRita/shorn">GitHub</a>
      </nav>
    </header>

    <main>
      <h1 class:list={[size]}>{headline}</h1>
      <p><slot /></p>
      {/* One box, so the code and the actions form a column whose bottom can be matched
          to the figure's. `display: contents` below dissolves it again when the hero
          stacks, so the reading order there stays code, figure, actions. */}
      <div class="demo">
        {/* `wrap`: on a phone the payoff comments are wider than the block, and they carry
            the argument, so they wrap under a hanging indent rather than scroll away. */}
        {code && code.length > 0 && <Code code={code.join("\n")} lang="ts" wrap hangingIndent={2} />}
        <div class="actions">
          <a class="btn" href={p("getting-started/quick-start/")}>{cta}</a>
          <span class="cmd">
            <code>{install}</code>
            {/* `aria-live` on the button itself rather than a region on the page: the only
                thing in here that ever changes is this label, and it only changes on
                click, so nothing is announced on load or on hover. Without it the swap to
                "copied" is silent and the button reads as having done nothing. */}
            <button type="button" data-copy={install} aria-live="polite">Copy</button>
          </span>
        </div>
      </div>
      <slot name="figure" />
    </main>

    <slot name="after" />

    <footer>
      MIT licensed. An experimental alpha. <a href={p("about/")}>About</a> · <a
        href={p("contact/")}>Contact</a
      > · <a href={p("privacy/")}>Privacy</a>
    </footer>

    <script>
      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          // Rejects outside a secure context and when the permission is denied.
          // Unhandled, the label never changes and the button reads as broken.
          try {
            await navigator.clipboard.writeText(btn.dataset.copy ?? "");
            btn.textContent = "Copied";
          } catch {
            // Not a keyboard hint: the shortcut differs per platform, and the command
            // is right there in the `<code>` beside it to select by hand.
            btn.textContent = "Copy failed";
          }
          setTimeout(() => {
            btn.textContent = "Copy";
          }, 1600);
        });
      });
    </script>

    <style>
      /* Minimalist by constraint on content, not on rendering: one nav, one
         headline, one sentence, one primary action. Everything that was
         decoration is deleted rather than flattened.

         Monochrome: true neutral greys, no accent hue anywhere. Emphasis comes
         from size and from inversion (the button is ink-on-ground). The one
         exception is the code block, which is syntax-coloured exactly as the docs
         are, because it is the same component.

         Greys checked against --shorn-bg: ink-2 is 7.66:1 and ink-3 is 4.61:1, so
         both clear 4.5:1 at normal text size. */
      :root {
        --sans: "Geist Sans", ui-sans-serif, system-ui, sans-serif;
        --mono: "Geist Mono", ui-monospace, "SF Mono", Menlo, monospace;
        color-scheme: dark;
      }

      * {
        box-sizing: border-box;
      }

      /* The grid is what buys the negative space: the hero row takes every pixel
         the header and footer do not, and centres one short block inside it. */
      body {
        /* Capped and centred rather than edge-to-edge. Padding alone left the page
           growing with the monitor, so at 1920 the hero ran ~1730px wide and every
           section rule stretched with it. A bounded measure is part of the minimal
           setting, not a departure from it: the constraint is on content, and this is
           the content's width. Above the cap the margin grows instead of the text.

           1500px: wide enough that the cap reads as a margin rather than a column, and
           still comfortably past the 1240px viewport where the two-column hero starts. */
        margin: 0 auto;
        max-width: 1500px;
        min-height: 100vh;
        display: grid;
        grid-template-rows: auto 1fr auto;
        padding: 0 clamp(24px, 7vw, 96px);
        background: var(--shorn-bg);
        color: var(--shorn-ink);
        font-family: var(--sans);
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      /* Grid items otherwise keep the code block's min-content width and make the
         whole page wider than a phone viewport. The code and byte figure own their
         horizontal scrolling; the page itself must stay at the viewport width. */
      :global(body > *) {
        min-width: 0;
      }

      a {
        color: inherit;
      }

      /* The focus ring is in tokens.css, not here. Astro scopes component styles with a
         per-file hash, and HeroShear.astro carries a different one, so a `:focus-visible`
         rule in this file never reached the replay button it slots in: measured at tab stop
         7 that button reported Chrome's `1px auto rgb(153, 200, 255)`, the only chromatic
         pixel on a page whose stated law is no accent hue anywhere. Both files already read
         tokens.css, so that is where a rule both of them need belongs. */

      /* ---------- header: the one navigation ---------- */
      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 28px 0;
      }

      /* Mark and wordmark are one ink weight, since there is no accent to split them
         with, and the mark reads at 20px without one. */
      .brand {
        display: flex;
        align-items: center;
        gap: 9px;
        font-weight: 500;
        text-decoration: none;
        color: var(--shorn-ink);
      }
      .brand svg {
        flex: none;
      }

      nav {
        display: flex;
        gap: clamp(18px, 3vw, 32px);
        font-size: 14.5px;
        color: var(--shorn-ink-2);
      }

      /* Words, never mystery-meat icons: every destination stays legible. */
      nav a {
        text-decoration: none;
      }
      nav a:hover {
        color: var(--shorn-ink);
      }

      /* ---------- the message ---------- */
      main {
        align-self: center;
        /* Capped at 64px rather than 88px so the full hero (headline, prose,
           demonstration, figure, action) clears a 960px-tall viewport without a
           scroll. The grid below is what made that possible. */
        padding: clamp(28px, 4vh, 56px) 0;
        /* Anything in the `after` slot adds a fourth body row, which would collapse
           the 1fr hero to its content height. This keeps the hero a screenful either
           way; 160px is the header and footer together. */
        min-height: calc(100svh - 160px);
        align-content: center;
      }

      /* Once there is room, the demonstration and the figure sit side by side
         rather than stacking. Stacked they push the page 363px past the fold while
         more than half the width sits unused, and the negative space is better spent
         on breathing room than on a scroll. Below this width they stack.

         1320px, not 1040px: at 1040 each column is ~426px, which leaves the code block
         382px of text after its padding and quietly scrolls its longest comment out of
         view. The comments here carry the argument, so the two-column layout only
         starts once a column can hold the full 62ch block.

         Back to 1240 from 1400: the byte table that needed the extra width has moved
         out of the hero, and the strips that replaced it wrap, so a narrower column costs
         a wrapped row rather than a clipped one. */
      /* Stacked, the wrapper is not a box at all: its children become children of `main`
         so the figure can be ordered between them and the reading order stays code,
         figure, actions. `order` needs them to be items of the same formatting context,
         which is what `display: contents` buys. */
      main {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
      }

      .demo {
        display: contents;
      }

      main > .demo > :global(.expressive-code) {
        order: 1;
      }

      /* The actions come before the figure, not after it. Measured against a 900px
         viewport: with the 465-493px figure in between, the button's top sat at y=1281 at
         390px wide, y=1255 at 1024 and y=1266 at 1239, so on every width below the
         two-column breakpoint the one thing this page asks the reader to do was a screen
         and a half down. Only the 1240px layout put an action on the first screen. */
      main > .demo > .actions {
        order: 2;
        /* The figure carries its own bottom margin, so once the actions moved above it
           there was nothing separating the two. */
        margin-bottom: clamp(28px, 4vh, 40px);
      }

      main > :global(figure) {
        order: 3;
      }

      @media (min-width: 1240px) {
        main {
          display: grid;
          grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
          gap: clamp(22px, 3vh, 34px) clamp(32px, 4vw, 64px);
          align-items: start;
        }

        /* Rows are placed by hand rather than auto-flowed. The actions belong under the
           code block, and `grid-column: 1` alone does not get them there: auto-flow puts
           them in the row after the demonstration, so the taller of the two columns (the
           figure) still pushes them down and leaves a void under the snippet. Giving the
           figure both of the bottom rows lets the actions sit directly beneath the code
           they are the next step for. */
        main > h1 {
          grid-column: 1 / -1;
          grid-row: 1;
        }

        main > p {
          grid-column: 1 / -1;
          grid-row: 2;
        }

        /* Stretched, not content-height: the row is as tall as the figure beside it, and
           filling it squares the two columns off at the same baseline instead of leaving
           the code block floating in a taller row. The slack lands inside the card, below
           the last line, which reads as deliberate padding. */
        /* A real box again, and the left column. A flex column with the code block
           growing means the actions sit on its bottom edge, and the column as a whole is
           the same height as the figure, so the button's bottom is the figure's bottom.
           Grid rows alone could not do this: the figure sits at the top of whatever rows
           it spans, so its bottom is never the row's bottom. */
        .demo {
          display: flex;
          flex-direction: column;
          gap: clamp(22px, 3vh, 34px);
          grid-column: 1;
          grid-row: 3;
          /* The grid sets `align-items: start`, which would leave this column at content
             height and the actions floating above the figure's bottom edge. */
          align-self: stretch;
        }

        .demo > :global(.expressive-code) {
          flex: 1;
        }



        /* `:global`, because the figure is slotted in from another component and so
           does not carry this file's scope attribute. Without it the selector silently
           matches nothing, which is what left the actions stranded at the bottom. */
        /* `:global`, because the figure is slotted in from another component and so does
           not carry this file's scope attribute; without it the selector silently matches
           nothing, which is a quiet way to lose a rule. */
        main > :global(figure) {
          grid-column: 2;
          grid-row: 3;
        }

        /* The grid owns vertical rhythm here. Leaving the stacked-layout bottom
           margins on would double it and push the hero back past the fold.

           `main > .demo > .actions` and not `.demo > .actions`: the stacked rule that
           separates the actions from the figure is three classes deep, and a media query
           adds no specificity, so a two-class selector in here loses to it and the
           two-column column would carry a 40px tail under the button. */
        main > h1,
        main > p,
        .demo > :global(.expressive-code),
        main > .demo > .actions,
        main > :global(figure) {
          margin-bottom: 0;
        }
      }

      /* The headline is deliberately not held to the prose measure: it is the
         one typographic moment, and the prose below it is the only other text. */
      h1 {
        margin: 0 0 clamp(20px, 3vh, 34px);
        font-weight: 500;
        letter-spacing: -0.04em;
        text-wrap: balance;
      }

      h1.xl {
        font-size: clamp(62px, 17vw, 208px);
        line-height: 0.9;
        letter-spacing: -0.05em;
      }

      h1.lg {
        font-size: clamp(44px, 8.5vw, 104px);
        line-height: 0.95;
        max-width: 22ch;
      }

      h1.md {
        font-size: clamp(36px, 6vw, 72px);
        line-height: 1.02;
        max-width: 26ch;
      }

      /* Prose keeps a readable measure even though the headline does not. */
      main p {
        margin: 0 0 clamp(28px, 4vh, 44px);
        max-width: 52ch;
        font-size: 17px;
        color: var(--shorn-ink-2);
      }

      main p b {
        color: var(--shorn-ink);
        font-weight: 500;
      }

      main p code {
        font-family: var(--mono);
        font-size: 0.88em;
      }

      /* ---------- the demonstration ---------- */
      /* The docs' code block on the docs' panel. The first three are the overrides
         custom.css gives every snippet inside Starlight, and the rest are what Starlight
         itself hands expressive-code there; this page loads neither, so both are
         restated. Without them the panel lost its border and fell back to the system
         monospace. */
      :root {
        --ec-codeBg: var(--shorn-surface);
        --ec-frm-edBg: var(--shorn-surface);
        --ec-brdRad: var(--shorn-radius);
        --ec-brdCol: var(--shorn-rule);
        --ec-codeFontFml: var(--mono);
        --ec-codeFontSize: 0.875rem;
        --ec-codeLineHt: 1.75;
      }

      .demo > :global(.expressive-code) {
        /* 64ch, not 60ch: the cap includes the block's padding, and 60ch left the
           56-character comment with zero slack in Geist Mono. */
        max-width: 64ch;
        margin: 0 0 clamp(28px, 4vh, 40px);
      }

      /* Side by side, the block is stretched to the figure's height (see `.demo` above),
         so the frame and the pre inside it have to stretch with it, or the panel ends
         at its last line and the slack shows as bare page under it. */
      @media (min-width: 1240px) {
        .demo > :global(.expressive-code),
        .demo > :global(.expressive-code .frame) {
          display: flex;
          flex-direction: column;
        }

        .demo > :global(.expressive-code .frame),
        .demo > :global(.expressive-code pre) {
          flex: 1;
        }
      }

      /* ---------- the one primary action ---------- */
      .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 14px 22px;
      }

      .btn {
        padding: 11px 22px;
        border-radius: var(--shorn-radius);
        background: var(--shorn-ink);
        color: var(--shorn-bg);
        font-size: 15px;
        font-weight: 500;
        text-decoration: none;
      }
      .btn:hover {
        filter: brightness(0.92);
      }

      /* The install command as a field with its copy button attached, the height of the
         primary button beside it. It used to be bare text with a 12px ink-3 "copy" after
         it, which read as a caption rather than as something to press. */
      .cmd {
        display: inline-flex;
        align-items: stretch;
        /* The primary button's height when they share a row, and never under the 44px a
           touch target wants when the row wraps and it sits alone. */
        align-self: stretch;
        min-height: 44px;
        max-width: 100%;
        background: var(--shorn-surface);
        border: 1px solid var(--shorn-rule);
        border-radius: var(--shorn-radius);
        font-family: var(--mono);
        font-size: 13.5px;
        color: var(--shorn-ink-2);
      }

      /* Scrolls rather than pushing the button off a narrow phone. */
      .cmd code {
        display: flex;
        align-items: center;
        min-width: 0;
        padding: 0 14px;
        overflow-x: auto;
        white-space: nowrap;
      }

      .cmd button {
        flex: none;
        /* Wide enough for "Copied" too, so the label change does not move the edge. */
        min-width: 9ch;
        padding: 0 14px;
        border: 0;
        border-left: 1px solid var(--shorn-rule);
        border-radius: 0 var(--shorn-radius) var(--shorn-radius) 0;
        background: none;
        cursor: pointer;
        font-family: var(--mono);
        font-size: 12.5px;
        color: var(--shorn-ink);
      }
      .cmd button:hover {
        background: var(--shorn-rule);
      }

      footer {
        padding: 28px 0;
        font-size: 13.5px;
        color: var(--shorn-ink-3);
      }

      /* Measured 38x15, 50x15 and 46x15, so only the height was under the 24x24 WCAG 2.5.8
         floor. Vertical padding on an inline box grows the target without moving the line
         it sits on, so this costs no layout and no negative margin. */
      footer a {
        padding: 6px 0;
      }
    </style>
  </body>
</html>
