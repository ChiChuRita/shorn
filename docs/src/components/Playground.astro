---
// Zod and shorn load only when the playground approaches the viewport, and ArkType or
// Valibot only when a reader picks one.
import { DEFAULT_PAYLOAD, VALIDATORS } from "./toy";
// The same two strips the hero draws, here fed by whatever you type.
import "../styles/strips.css";

// BASE_URL carries the configured base with a trailing slash, so strip it before
// joining or the link below emits a doubled separator.
const sizeResults = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/performance/size/`;
---

<section data-playground aria-labelledby="toy">
  <h2 id="toy">Try it</h2>
  <p>Pick a validator, then edit its schema and the payload. The real encoder runs in your browser tab, and nothing you type leaves it.</p>

  {/* Radios rather than buttons: one of three is always chosen, and arrow keys move
      between them for free. Shown only once the script runs, since without it the
      choice would do nothing. */}
  <fieldset class="pick" data-pick>
    <legend>Validator</legend>
    {
      Object.entries(VALIDATORS).map(([name, { label }]) => (
        <label>
          <input type="radio" name="toy-validator" value={name} checked={name === "zod"} />
          {label}
        </label>
      ))
    }
  </fieldset>

  <div class="io">
    {/* Each box is a stack: the real text box, and over it a mirror of its text in the
        docs' colours. The mirror only takes over once the script has run (`lit` on the
        section), so without JS the box shows its own text as before. `aria-hidden`
        because the text box already is the text.

        A `<label for>` rather than a wrapping label, so the suggestion list can sit beside
        the box without its text joining the box's accessible name.

        The list after each box is its suggestions. The box keeps focus while you move
        through them, and `aria-activedescendant` (set by the script) is how a screen
        reader hears which one is picked. */}
    <div class="field">
      <label for="toy-schema" data-schema-label>Zod schema</label>
      <span class="editor"><span class="mirror" aria-hidden="true" data-mirror="ts"></span><textarea
        id="toy-schema"
        data-schema
        aria-describedby="toy-keys"
        aria-autocomplete="list"
        aria-controls="toy-complete-schema"
        spellcheck="false"
        rows="8"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off">{VALIDATORS.zod.schema}</textarea><ul
        class="complete"
        id="toy-complete-schema"
        role="listbox"
        aria-label="Suggestions"
        hidden></ul></span>
    </div>
    <div class="field">
      <label for="toy-payload">payload</label>
      <span class="editor"><span class="mirror" aria-hidden="true" data-mirror="json"></span><textarea
        id="toy-payload"
        data-payload
        aria-describedby="toy-keys"
        aria-autocomplete="list"
        aria-controls="toy-complete-payload"
        spellcheck="false"
        rows="8"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off">{DEFAULT_PAYLOAD}</textarea><ul
        class="complete"
        id="toy-complete-payload"
        role="listbox"
        aria-label="Suggestions"
        hidden></ul></span>
    </div>
  </div>

  {/* `id` so both boxes can point at it: the hint sits after the inputs in DOM order, so
      a screen reader tabbing in announced "Zod schema, edit text, multiline" and nothing
      about Escape. `aria-describedby` reads it out regardless of where it sits. */}
  <p class="hint" id="toy-keys">Suggestions appear as you type: arrows move, Enter or Tab picks. Otherwise Tab indents, and Escape first lets it leave the box.</p>

  {/* Same figure as the hero, live. Hidden until the first successful run so a failed
      parse leaves the last good drawing up rather than an empty frame.

      One labelled image, like the hero panel: the 104 `<i>` cells in here came back from
      the accessibility tree as 104 separate text nodes, so the payload was spelled out a
      character at a time and then read as 98 hex pairs. `run()` writes the label.

      The two paragraphs below used to live inside this div. `role="img"` would have
      buried both, and they are prose a reader needs: one says where the saving comes
      from, the other admits the drawing is of an older input. */}
  <div class="bytes wrap" data-diagram role="img" hidden>
    <p class="lane">JSON<span data-json-count></span></p>
    <div class="strip lines" data-json-strip></div>
    <div class="split"><span data-delta></span></div>
    <p class="lane">shorn, as hex<span data-wire-count></span></p>
    <div class="strip wire hex big" data-wire-strip></div>
  </div>

  <p class="packed" data-packed hidden></p>
  <p class="stale" data-stale-note hidden>Showing the last input that parsed.</p>

  <p data-out aria-live="polite">loading the encoder…</p>

  {/* The default record is four booleans, an enum and an int, the best case this encoder
      has: it reads 16.33x here, against the 4.35x the size section below quotes as its
      four-fixture ceiling. A reader who spots that gap unaided discounts both figures.
      No number in the line itself, so re-measuring the fixtures cannot make it false. */}
  <p class="caveat">
    The record above is a deliberate best case: booleans and enum members are what shorn
    shrinks hardest. Every figure quoted elsewhere on this page is measured on the
    <a href={sizeResults}>benchmark fixtures</a> instead, which are ordinary records.
  </p>
</section>

<script>
  import {
    compare,
    completePayload,
    completeSchema,
    fieldsOf,
    measure,
    tokenize,
    VALIDATORS,
    type Codec,
    type Completion,
    type Lib,
    type Validator,
  } from "./toy";

  const section = document.querySelector<HTMLElement>("[data-playground]");
  if (section) {
    const schemaEl = section.querySelector<HTMLTextAreaElement>("[data-schema]")!;
    const payloadEl = section.querySelector<HTMLTextAreaElement>("[data-payload]")!;
    const out = section.querySelector<HTMLElement>("[data-out]")!;
    const diagram = section.querySelector<HTMLElement>("[data-diagram]")!;
    const jsonStrip = section.querySelector<HTMLElement>("[data-json-strip]")!;
    const wireStrip = section.querySelector<HTMLElement>("[data-wire-strip]")!;
    const jsonCount = section.querySelector<HTMLElement>("[data-json-count]")!;
    const wireCount = section.querySelector<HTMLElement>("[data-wire-count]")!;
    const deltaEl = section.querySelector<HTMLElement>("[data-delta]")!;
    const packed = section.querySelector<HTMLElement>("[data-packed]")!;
    const staleNote = section.querySelector<HTMLElement>("[data-stale-note]")!;

    // A 40 KB payload would otherwise draw 40,000 cells. High enough that an ordinary
    // record draws in full (the default one is 98 bytes, and truncating it at 96 was
    // absurd), and low enough that pasting a large array cannot lock the tab up.
    const CAP = 320;

    /** One cell per glyph, in a run that the caller can ink as key or as value. */
    const runTo = (parent: Node, glyphs: string[], lift: boolean) => {
      const run = document.createElement("span");
      run.className = lift ? "tok run" : "tok";
      for (const g of glyphs) {
        const cell = document.createElement("i");
        cell.textContent = g;
        run.append(cell);
      }
      parent.appendChild(run);
    };

    const truncate = (parent: Node, hidden: number) => {
      if (hidden <= 0) return;
      const more = document.createElement("span");
      more.className = "more";
      more.textContent = `+${hidden} more`;
      parent.appendChild(more);
    };

    // Two spaces, matching the indentation the defaults ship with and `tab-size: 2`.
    const INDENT = "  ";

    /** Write through the browser's own editing pipeline so undo still works. */
    const type = (el: HTMLTextAreaElement, text: string) => {
      // `execCommand` is deprecated but remains the only way to mutate a textarea and
      // keep its native undo stack. Falling back loses undo, not the edit.
      if (!document.execCommand("insertText", false, text)) {
        const { selectionStart, selectionEnd } = el;
        el.setRangeText(text, selectionStart, selectionEnd, "end");
      }
    };

    /**
     * The open suggestion list, if any. One at a time: only the focused box can have one.
     *
     * Placed at the caret by asking the mirror where it is. The mirror holds the box's
     * text glyph for glyph and wraps identically, so a range over the character before
     * the caret lands exactly where the box draws it, scroll included.
     */
    let open: { el: HTMLTextAreaElement; list: HTMLElement; hit: Completion; active: number } | null = null;

    const listOf = (el: HTMLTextAreaElement) => el.nextElementSibling as HTMLElement;

    const close = () => {
      if (!open) return;
      open.list.hidden = true;
      open.el.removeAttribute("aria-activedescendant");
      open = null;
    };

    const highlight = (index: number) => {
      if (!open) return;
      const items = open.list.children;
      open.active = (index + items.length) % items.length;
      for (const [i, item] of [...items].entries()) item.setAttribute("aria-selected", String(i === open.active));
      const current = items[open.active] as HTMLElement;
      open.el.setAttribute("aria-activedescendant", current.id);
      current.scrollIntoView({ block: "nearest" });
    };

    const accept = (index = open?.active ?? 0) => {
      if (!open) return;
      const { el, hit } = open;
      const item = hit.items[index];
      close();
      el.setSelectionRange(hit.from, el.selectionStart);
      type(el, hit.call ? `${item}()` : item);
      // Between the parentheses, where the arguments go. `z.string()` then needs only a
      // step right, which is cheaper than typing `(` and `)` for every builder.
      if (hit.call) el.setSelectionRange(el.selectionStart - 1, el.selectionStart - 1);
    };

    /** Where the caret is drawn, relative to the box's editor wrapper. */
    const caretAt = (el: HTMLTextAreaElement) => {
      const mirror = el.previousElementSibling as HTMLElement;
      const target = Math.max(el.selectionStart - 1, 0);
      const walker = document.createTreeWalker(mirror, NodeFilter.SHOW_TEXT);
      let seen = 0;
      for (let node = walker.nextNode(); node; node = walker.nextNode()) {
        const length = node.textContent!.length;
        if (seen + length > target) {
          const range = document.createRange();
          range.setStart(node, target - seen);
          range.setEnd(node, target - seen + 1);
          const rect = [...range.getClientRects()].at(-1) ?? range.getBoundingClientRect();
          const box = el.parentElement!.getBoundingClientRect();
          return { left: rect.right - box.left, top: rect.bottom - box.top };
        }
        seen += length;
      }
      return { left: 14, top: 12 };
    };

    const suggest = (el: HTMLTextAreaElement) => {
      const caret = el.selectionStart;
      const hit =
        caret !== el.selectionEnd
          ? null
          : el === schemaEl
            ? completeSchema(el.value, caret, validator)
            : completePayload(el.value, caret, fields);
      if (!hit) return close();

      const list = listOf(el);
      if (open && open.el !== el) close();
      list.replaceChildren(
        ...hit.items.map((label, i) => {
          const item = document.createElement("li");
          item.id = `${list.id}-${i}`;
          item.setAttribute("role", "option");
          item.textContent = label;
          // `mousedown`, not `click`: a click would blur the box first and close the list.
          item.addEventListener("mousedown", (event) => {
            event.preventDefault();
            accept(i);
          });
          return item;
        }),
      );
      list.hidden = false;
      open = { el, list, hit, active: 0 };
      highlight(0);

      // Below the caret, pulled back in if it would run past the box's right edge.
      const { left, top } = caretAt(el);
      const room = el.parentElement!.clientWidth - list.offsetWidth;
      list.style.left = `${Math.max(0, Math.min(left, room))}px`;
      list.style.top = `${top + 2}px`;
    };

    // Trapping Tab inside a text box strands keyboard users, so Escape releases it: the
    // next Tab then moves focus as usual. That pairing is the accessible version of this
    // affordance, and the hint above the box says so.
    const onKeydown = (event: KeyboardEvent) => {
      const el = event.currentTarget as HTMLTextAreaElement;
      // An open list takes the keys first, so Escape closes it rather than leaving the
      // box, and Tab picks rather than indents.
      if (open?.el === el) {
        const plain = !event.metaKey && !event.ctrlKey && !event.altKey && !event.shiftKey;
        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
          event.preventDefault();
          highlight(open.active + (event.key === "ArrowDown" ? 1 : -1));
          return;
        }
        if ((event.key === "Enter" || event.key === "Tab") && plain) {
          event.preventDefault();
          accept();
          return;
        }
        if (event.key === "Escape") {
          event.preventDefault();
          close();
          return;
        }
        // The caret is about to move somewhere the list was not computed for.
        if (["ArrowLeft", "ArrowRight", "Home", "End", "PageUp", "PageDown"].includes(event.key)) close();
      }
      if (event.key === "Escape") {
        el.blur();
        return;
      }
      if (event.key !== "Tab" || event.metaKey || event.ctrlKey || event.altKey) return;
      event.preventDefault();

      if (!event.shiftKey) {
        type(el, INDENT);
        return;
      }
      // Outdent: eat up to one indent of whitespace immediately before the caret.
      const caret = el.selectionStart;
      const lineStart = el.value.lastIndexOf("\n", caret - 1) + 1;
      const before = el.value.slice(lineStart, caret);
      const strip = Math.min(INDENT.length, before.length - before.trimEnd().length);
      if (strip === 0) return;
      el.setSelectionRange(caret - strip, caret);
      if (!document.execCommand("delete")) el.setRangeText("", caret - strip, caret, "end");
    };

    /**
     * Fit the taller of the two, and give both that height.
     *
     * Sizing each box to its own content made them disagree the moment their line counts
     * did, which reads as one box shrinking rather than as two boxes fitting. They are a
     * pair, so they get one height.
     *
     * Collapsing to 0 before measuring rather than to "auto": with `rows` set, `auto`
     * resolves to the rows height, so `scrollHeight` never reports less than that and a
     * box could grow but never come back down. `min-height` in the stylesheet keeps the
     * pair from ever looking like single-line inputs.
     */
    const fit = () => {
      const boxes = [schemaEl, payloadEl];
      for (const el of boxes) el.style.height = "0";
      // `scrollHeight` is content plus padding and excludes the border, but the box is
      // `border-box`, so assigning it straight back leaves the content two pixels short
      // and the browser answers with a scrollbar. Add the border the height has to cover.
      const border = boxes.map((el) => {
        const cs = getComputedStyle(el);
        return parseFloat(cs.borderTopWidth) + parseFloat(cs.borderBottomWidth);
      });
      const tallest = Math.min(Math.max(...boxes.map((el, i) => el.scrollHeight + border[i])), 520);
      for (const el of boxes) el.style.height = `${tallest}px`;
    };

    /** Redraw one box's coloured mirror from its text. */
    const paint = (el: HTMLTextAreaElement) => {
      const mirror = el.previousElementSibling as HTMLElement;
      const lang = mirror.dataset.mirror === "json" ? "json" : "ts";
      mirror.replaceChildren(
        ...tokenize(el.value, lang).map(({ text, kind }) => {
          if (kind === "plain") return document.createTextNode(text);
          const span = document.createElement("span");
          span.className = kind;
          span.textContent = text;
          return span;
        }),
      );
      // A trailing newline opens a line the text box shows and an inline run collapses,
      // so the mirror would end one line short.
      if (el.value.endsWith("\n")) mirror.append(" ");
      follow(el);
    };

    /** Scroll the mirror with its box. Once a box hits its height cap it scrolls. */
    const follow = (el: HTMLTextAreaElement) => {
      const mirror = el.previousElementSibling as HTMLElement;
      mirror.scrollTop = el.scrollTop;
      mirror.scrollLeft = el.scrollLeft;
    };

    /** Load once, but forget a failure, or one network blip would fail every retry too. */
    const memo = <T,>(load: () => Promise<T>) => {
      let p: Promise<T> | null = null;
      return () =>
        (p ??= load().catch((error) => {
          p = null;
          throw error;
        }));
    };

    // One dynamic import per validator, so a reader who never leaves Zod never
    // downloads ArkType or Valibot.
    const libs: Record<Validator, () => Promise<Lib>> = {
      zod: memo(() => import("zod").then((m) => ({ binding: "z", ns: m.z }))),
      arktype: memo(() => import("arktype").then((m) => ({ binding: "type", ns: m.type }))),
      valibot: memo(() =>
        Promise.all([import("valibot"), import("@valibot/to-json-schema")]).then(([v, j]) => ({
          binding: "v",
          ns: v,
          structure: (schema: any) => j.toStandardJsonSchema(schema),
        })),
      ),
    };
    const codec = memo(() =>
      import("@chichurita/shorn").then((s): Codec => ({ encode: s.encode, decode: s.decode })),
    );
    const ready = new Set<Validator>();

    let validator: Validator = "zod";
    /** The schema text as each validator last had it, so switching back loses nothing. */
    const drafts: Partial<Record<Validator, string>> = {};
    /** The current schema's fields, for the payload box's suggestions. */
    let fields = new Map<string, string[]>();

    const run = async () => {
      // Read before awaiting: a switch during the load must not have this run draw the
      // new validator's name over the old validator's result.
      const current = validator;
      try {
        if (!ready.has(current)) out.textContent = `loading ${VALIDATORS[current].label}…`;
        // Inside the try: a failed dynamic import would otherwise escape.
        const [lib, shorn] = await Promise.all([libs[current](), codec()]);
        ready.add(current);
        if (current !== validator) return;
        // Before `measure`, which throws on a half-typed payload: that is exactly when
        // the payload box needs the field names.
        fields = fieldsOf(lib, schemaEl.value);
        const { bytes, json, lines, jsonSize, roundTrips } = measure(
          lib,
          shorn,
          schemaEl.value,
          payloadEl.value,
        );

        // The JSON lane, one field per line, capped by character rather than by run so a
        // single long value cannot blow past the cap on its own.
        jsonStrip.replaceChildren();
        let drawn = 0;
        for (const line of lines) {
          if (drawn >= CAP) break;
          const row = document.createElement("div");
          row.className = line.indent ? "line in" : "line";
          for (const run of line.runs) {
            if (drawn >= CAP) break;
            const glyphs = [...run.text].slice(0, CAP - drawn);
            runTo(row, glyphs, run.lift);
            drawn += glyphs.length;
          }
          jsonStrip.append(row);
        }
        // On the last line drawn rather than under them all: the marker belongs at the
        // point the drawing stops.
        truncate(jsonStrip.lastElementChild ?? jsonStrip, [...json].length - drawn);

        // Hex. Drawing the decoded values instead read better but
        // lied about the size: `true` is four glyphs and one byte, so four boxes said
        // four bytes. The hero is where the bytes get named; here they are counted.
        wireStrip.replaceChildren();
        runTo(wireStrip, [...bytes.slice(0, CAP)].map((b) => b.toString(16).padStart(2, "0")), true);
        truncate(wireStrip, bytes.length - Math.min(bytes.length, CAP));

        jsonCount.textContent = ` · ${jsonSize} bytes`;
        wireCount.textContent = ` · ${bytes.length} bytes`;
        packed.textContent =
          `There are no field names in those bytes. They stay in your schema, and that ` +
          `is where the saving comes from. Whole numbers take as few bytes as they need, ` +
          `an enum member is a small index, and a string is its UTF-8 bytes behind a length.`;
        const saved = jsonSize - bytes.length;
        deltaEl.textContent = saved === 0 ? "same size" : `${saved > 0 ? "−" : "+"}${Math.abs(saved)} bytes`;
        const verdict = compare(bytes.length, jsonSize);
        // The whole figure as one sentence, in place of the cells. Written here rather
        // than in the markup because these are the only numbers that are true of what is
        // currently drawn, and a label that lags the drawing is worse than none.
        diagram.setAttribute(
          "aria-label",
          `Two byte strips. This record is ${jsonSize} bytes of JSON and ${bytes.length} bytes of shorn: ${verdict.ratio} ${verdict.unit}, ${verdict.delta}.`,
        );
        diagram.hidden = false;
        packed.hidden = false;
        staleNote.hidden = true;
        delete out.dataset.error;

        out.textContent = `${verdict.ratio} ${verdict.unit}, ${verdict.delta}. ${
          roundTrips ? "Round-trips to identical bytes." : "Round-trip mismatch, please report it."
        }`;
      } catch (error) {
        if (current !== validator) return;
        // The last good drawing stays up, dimmed, so you can see what you broke against
        // what worked. The message is the one red thing on the page.
        out.dataset.error = "";
        // Only worth saying once there is a drawing to be stale.
        staleNote.hidden = diagram.hidden;
        out.textContent = error instanceof Error ? error.message : String(error);
      }
    };

    let timer: ReturnType<typeof setTimeout>;
    const schedule = () => {
      clearTimeout(timer);
      timer = setTimeout(run, 180);
    };
    for (const el of [schemaEl, payloadEl]) {
      el.addEventListener("input", schedule);
      el.addEventListener("keydown", onKeydown);
      el.addEventListener("input", fit);
      el.addEventListener("input", () => paint(el));
      // After `paint`: the list is placed by measuring the mirror, so it must be current.
      el.addEventListener("input", () => suggest(el));
      el.addEventListener("scroll", () => {
        follow(el);
        // Re-placed rather than closed: a box at its height cap scrolls as you type.
        if (open?.el === el) suggest(el);
      });
      el.addEventListener("blur", close);
      el.addEventListener("pointerdown", close);
      paint(el);
    }

    const label = section.querySelector<HTMLElement>("[data-schema-label]")!;
    section.querySelector("[data-pick]")!.addEventListener("change", (event) => {
      const next = (event.target as HTMLInputElement).value as Validator;
      drafts[validator] = schemaEl.value;
      validator = next;
      fields = new Map();
      close();
      label.textContent = `${VALIDATORS[next].label} schema`;
      // A switch, not an edit, so assigned directly rather than through the undo stack.
      schemaEl.value = drafts[next] ?? VALIDATORS[next].schema;
      paint(schemaEl);
      fit();
      void run();
    });
    section.classList.add("lit");
    fit();
    // Wrapping changes with the width, so a resize changes how tall "fits" is.
    addEventListener("resize", fit);

    // Nothing is imported until the toy is nearly on screen.
    new IntersectionObserver(
      (entries, self) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        self.disconnect();
        void run();
      },
      { rootMargin: "300px" },
    ).observe(section);
  }
</script>

<style>
  section {
    padding: clamp(48px, 8vh, 80px) 0 clamp(36px, 5vh, 56px);
    border-top: 1px solid var(--shorn-rule-soft);
    --measure: 812px;
  }

  h2 {
    margin: 0 0 6px;
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  section > p {
    margin: 0 0 20px;
    font-size: 15px;
    color: var(--shorn-ink-2);
  }

  .io {
    display: grid;
    gap: 12px;
    /* Side by side when both fit, stacked when they don't. No breakpoint to maintain.
       `min(260px, 100%)` rather than a bare 260px: below ~530px the bare version keeps
       a 260px floor the container cannot pay for, and the page scrolls sideways. */
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    max-width: var(--measure);
  }

  .field > label {
    display: block;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--shorn-ink-3);
  }

  /* A segmented control made of radios: the input stays in the page, focusable and
     announced, and only its dot is hidden, so the label is what you see and press. */
  .pick {
    display: none;
    gap: 4px;
    margin: 0 0 16px;
    padding: 0;
    border: 0;
  }

  .lit .pick {
    display: flex;
  }

  /* Read out as the group's name, not drawn: the three names say what they are. */
  .pick legend {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .pick label {
    position: relative;
    padding: 6px 12px;
    border: 1px solid transparent;
    border-radius: var(--shorn-radius);
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--shorn-ink-3);
    cursor: pointer;
  }

  .pick label:hover {
    color: var(--shorn-ink);
  }

  .pick label:has(:checked) {
    background: var(--shorn-surface);
    border-color: var(--shorn-rule);
    color: var(--shorn-ink);
  }

  .pick label:has(:focus-visible) {
    outline: 2px solid var(--shorn-ink);
    outline-offset: 2px;
