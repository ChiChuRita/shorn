---
// The hero's figure: the same record as JSON text and as shorn bytes, and the shearing
// of one into the other. The strips are drawn by strips.css, shared with the playground
// so the two read as the same figure at two sizes; everything in this file is the run.
import { m } from "@chichurita/shorn";
import "../styles/strips.css";

// The Person record the hero encodes, one field per row. `cells` is what the wire lane
// draws and `bytes` is what it costs, which are the same number everywhere except the
// varint: `34` is one byte, drawn as a box per digit so each character of the JSON has
// somewhere of its own to land. A box is therefore not always a byte, and the count
// beside the lane is the byte count. Both totals come from this table, so neither the
// 40 nor the 8 can drift away from what is drawn.
//
// The enum goes the other way: all five characters of `admin` land in one box, drawn as
// `0`, its index in the sorted members. That is the byte the encoder writes (checked
// below), and five letters collapsing into one digit is the enum rule, shown.
const fields = [
  { key: "name", raw: "Alice", quoted: true, cells: ["5", "A", "l", "i", "c", "e"], lengthCells: 1, bytes: 6 },
  { key: "age", raw: "34", quoted: false, cells: ["3", "4"], lengthCells: 0, bytes: 1 },
  { key: "role", raw: "admin", quoted: true, cells: ["0"], lengthCells: 0, bytes: 1 },
];

// The JSON as tokens rather than one string: the strip inks value characters differently
// from keys. Each character also carries its position in the run as `--i`, which is what
// staggers the shearing from the left instead of dropping the strip all at once.
//
// A surviving character also carries `to`: the wire cell it becomes, so the script can
// fly it there. One character, one cell, which is what the varint getting a box per digit
// above buys, except for the enum, whose characters all land on its one index.
//
// Broken into lines where a formatter would break, one field per line. The breaks and
// the indent are layout only: `n` still counts every character in order, so the strip
// is one cell per byte and the 40 is still 40.
let n = 0;
type Char = { c: string; i: number; to?: string };
type Line = { indent: boolean; tokens: { chars: Char[]; lift: boolean }[] };

const lines: Line[] = [];
const line = (indent: boolean) => lines[lines.push({ indent, tokens: [] }) - 1];
const tok = (into: Line, text: string, to?: (k: number) => string) =>
  into.tokens.push({ chars: [...text].map((c, k) => ({ c, i: n++, to: to?.(k) })), lift: !!to });

tok(line(false), "{");
for (const [i, f] of fields.entries()) {
  const row = line(true);
  tok(row, `"${f.key}":${f.quoted ? '"' : ""}`);
  // Value characters land after the length byte, and never past the last cell.
  tok(row, f.raw, (k) => `${f.key}-${Math.min(f.lengthCells + k, f.cells.length - 1)}`);
  if (f.quoted) tok(row, '"');
  // Trailing, so the comma sits on the line of the field it closes, exactly where a
  // formatter puts it, and in the same place in the byte order it was before.
  if (i < fields.length - 1) tok(row, ",");
}
tok(line(false), "}");

const jsonBytes = n;
const wireBytes = fields.reduce((c, f) => c + f.bytes, 0);
const shed = jsonBytes - wireBytes;

// The wire lane draws canonical order, which is the encoder's sort, not the order the
// JSON above is written in. It drew declaration order until 2026-09-10: name, age, sex,
// while the payload is `22 05 41 6c 69 63 65 00`, age first. So the one figure on the
// site whose whole claim is byte-exactness was also the one place contradicting
// `canonical-bytes.md`, which says field order is a rule of the format and not a schema
// option. The survivors now cross on their way down, which is the point rather than a
// cost: a character's position in the text does not decide its position in the bytes.
const wireFields = [...fields].sort((a, b) => (a.key < b.key ? -1 : 1));

// The check that keeps the drawing honest, run at build time against the real encoder:
// the count the lane prints, and the order it prints it in. A field added to the table
// above, or a change to the sort, fails the build instead of shipping a figure that
// disagrees with the bytes.
const real = m
  .object({ age: m.uint(), name: m.string(), role: m.enum(["viewer", "editor", "admin"]) })
  .encode({ name: "Alice", age: 34, role: "admin" });
if (real.length !== wireBytes) {
  throw new Error(`hero figure claims ${wireBytes} bytes, the encoder writes ${real.length}`);
}
// Each field's first drawn cell must sit at the byte offset the encoder puts it at.
let offset = 0;
for (const f of wireFields) {
  if (f.key === "name" && real[offset] !== f.raw.length) {
    throw new Error(`hero draws name at byte ${offset}, where the encoder writes ${real[offset]}`);
  }
  // The enum's box shows its index, so it has to be the index the encoder writes.
  if (f.key === "role" && real[offset] !== Number(f.cells[0])) {
    throw new Error(`hero draws role as ${f.cells[0]}, where the encoder writes ${real[offset]}`);
  }
  offset += f.bytes;
}

// The whole panel is one labelled image rather than 43 single characters for a screen
// reader to spell out, and the run is decoration on top of it.
const label = `The record {"name":"Alice","age":34,"role":"admin"} is ${jsonBytes} bytes of JSON. The same record is ${wireBytes} bytes of shorn, in the encoder's canonical field order: 34, then a length byte, then Alice, then 0, the index of admin among the enum's sorted members.`;
---

<figure class="hero-bytes">
  <div class="bytes lg wrap" role="img" aria-label={label}>
    <p class="lane">JSON<span> · {jsonBytes} bytes</span></p>
    {/* One source line per strip: a newline between these spans renders as a real space
        and opens a gap in the middle of a byte run. */}
    <div class="strip json lines">{lines.map((l) => (<div class:list={["line", { in: l.indent }]}>{l.tokens.map((t) => (<span class:list={["tok", { run: t.lift }]}>{t.chars.map((ch) => (<i style={`--i:${ch.i}`} data-to={ch.to}>{ch.c}</i>))}</span>))}</div>))}</div>

    {/* The total is rendered here so the static figure, the one a reduced-motion reader
        and a reader with no JS gets, states its own outcome. The run zeroes it the moment
        it arms: `armed` is the record with nothing taken off it yet, and −27 sitting there
        asserted the result of a shear that had not happened. */}
    <div class="split"><span data-count={`−{n} bytes, sheared`} data-shed={shed}>−{shed} bytes, sheared</span></div>

    <p class="lane out">shorn<span> · {wireBytes} bytes</span></p>
    <div class="strip wire">{wireFields.map((f) => (<span class="group"><span class="cells">{f.cells.map((c, ci) => (<i class:list={{ len: ci < f.lengthCells }} data-wire={`${f.key}-${ci}`}>{c}</i>))}</span><span class="field">{f.key}</span></span>))}</div>
  </div>

  <figcaption>
    The field names stay in your schema, so only the values go on the wire. A field is
    identified by its position, not by its name. <span class="gag">Nothing was lost: the
    names are still in your schema, where they were the whole time.</span>
    <button type="button" class="again" data-again>Shear it again</button>
  </figcaption>
</figure>

<script>
  // Not `document.currentScript`: Astro bundles this as a module script, where that is
  // always null.
  //
  // Plays once when the figure comes into view and then holds the sheared state. A loop
  // would be reading the same sentence out loud on repeat: the figure is an argument, and
  // an argument is made once. Scrolling it away and back, or the button under the
  // caption, is what asks for it again.
  const fig = document.querySelector<HTMLElement>(".hero-bytes");
  const box = fig?.querySelector<HTMLElement>(".bytes") ?? null;
  const still = matchMedia("(prefers-reduced-motion: reduce)");

  // The beats, in milliseconds from the moment the figure is asked to play. Held here
  // rather than in the stylesheet because the flight is measured in JS anyway, and
  // splitting the timing across two files is how one of them drifts. The stylesheet reads
  // the ones it needs back off the figure as custom properties, so these are the only copy.
  //
  // Slowed and smoothed from a 1.1s run. Filmed at 50ms a frame, that one lifted the
  // survivors out of the JSON (leaving holes), sent them 40ms apart so they crossed in a
  // cloud, and snapped each back into its old slot in one frame as it landed. Now a copy
  // makes the trip and the original never moves, and the copies leave in the order they
  // land, so the wire fills left to right.
  //
  // LEAD is a beat of nothing: the record has to be read as JSON before anything is taken
  // off it. DEPART is when the first copy leaves, STEP the space between copies, FLIGHT
  // how long one is in the air. COUNT is how long the delta on the divider takes to run
  // up, roughly how long the shorn cells take to go faint.
  const LEAD = 400;
  const DEPART = 120;
  const STEP = 90;
  const FLIGHT = 760;
  const COUNT = 900;
  // A soft start and a long settle: at full speed off the mark a copy looks thrown, and
  // one that stops dead looks dropped.
  const EASE = "cubic-bezier(0.5, 0, 0.2, 1)";
  // How long before a copy lands its wire cell starts inking underneath it, so lifting
  // the copy off reveals a finished cell rather than one still being drawn.
  const INK = 160;

  const timers: ReturnType<typeof setTimeout>[] = [];
  // Each copy in the air and the animation carrying it, so a replay can stop both. Only
  // removing the element left its animation running detached until it finished.
  const fliers: { el: HTMLElement; flight: Animation }[] = [];

  // Server-rendered with the total already in it, which is what the static figure needs.
  // Zeroed whenever the run takes over, in `play` and on arming, because the run is what
  // earns the number and `armed` is before any of it has happened.
  const counter = fig?.querySelector<HTMLElement>("[data-count]") ?? null;
  const tpl = counter?.dataset.count ?? "";
  const total = Number(counter?.dataset.shed);
  const zero = () => {
    if (counter) counter.textContent = tpl.replace("{n}", "0");
  };

  const play = () => {
    if (!fig || !box || still.matches) return;

    for (const t of timers) clearTimeout(t);
    timers.length = 0;
    for (const { el, flight } of fliers) {
      flight.cancel();
      el.remove();
    }
    fliers.length = 0;

    // Restart from the top on a replay. `reset` kills transitions for one frame first:
    // without it, dropping `playing` starts everything fading back while the next run
    // begins on top of it.
    fig.classList.add("reset");
    fig.classList.remove("playing", "done");
    void fig.offsetWidth;

    zero();

    // When the first byte is on the wire, which is when the shorn lane earns its label.
    fig.style.setProperty("--in", `${DEPART + FLIGHT}ms`);

    // One trip per surviving character, from its cell to the wire cell it becomes.
    // Measured every play rather than cached, because the strips wrap and the column width
    // moves the targets. Sorted by where they land, so they leave in wire order.
    const origin = box.getBoundingClientRect();
    const trips = [...fig.querySelectorAll<HTMLElement>("[data-to]")]
      .map((cell) => ({ cell, target: fig.querySelector<HTMLElement>(`[data-wire="${cell.dataset.to}"]`) }))
      .filter((t): t is { cell: HTMLElement; target: HTMLElement } => t.target !== null)
      .map((t) => ({ ...t, from: t.cell.getBoundingClientRect(), to: t.target.getBoundingClientRect() }))
      .sort((a, b) => a.to.top - b.to.top || a.to.left - b.to.left);

    trips.forEach(({ cell, target, from, to }, k) => {
      const depart = DEPART + k * STEP;
      // `--wd` counts from `playing`, which is LEAD after now; the flight below counts
      // from now, hence the LEAD on one and not the other.
      target.style.setProperty("--wd", `${depart + FLIGHT - INK}ms`);

      const flier = document.createElement("i");
      flier.className = "flier";
      flier.textContent = cell.textContent;
      flier.style.left = `${from.left - origin.left + box.scrollLeft}px`;
      flier.style.top = `${from.top - origin.top + box.scrollTop}px`;
      flier.style.width = `${from.width}px`;
      flier.style.height = `${from.height}px`;
      box.append(flier);

      const flight = flier.animate(
        [{ transform: "none" }, { transform: `translate(${to.left - from.left}px, ${to.top - from.top}px)` }],
        { duration: FLIGHT, delay: LEAD + depart, easing: EASE, fill: "both" },
      );
      fliers.push({ el: flier, flight });
      flight.finished.then(
        () => flier.remove(),
        // Cancelled by a replay, which removes it itself.
        () => {},
      );
    });

    // When the last byte is on the wire, measured from the trips that were actually found
    // rather than from a hardcoded 8. `done` is this instant, which is what the length
    // byte hangs off.
    const landed = DEPART + Math.max(0, trips.length - 1) * STEP + FLIGHT;

    fig.classList.remove("reset");
    fig.classList.add("armed");

    timers.push(
      setTimeout(() => {
        fig.classList.add("playing");
        // The count runs with the cells that are going faint, not after them, and eases
        // out with them rather than ticking at a constant rate and stopping dead.
        if (!counter) return;
        const from = performance.now();
        const tick = (now: number) => {
          const p = Math.min(1, (now - from) / COUNT);
          const eased = 1 - (1 - p) ** 3;
          counter.textContent = tpl.replace("{n}", String(Math.round(eased * total)));
          if (p < 1 && fig.classList.contains("playing")) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }, LEAD),

      setTimeout(() => {
        fig.classList.add("done");
        // Also where the count is settled: a backgrounded tab stops serving frames, and
        // the ticker above would otherwise leave it stranded mid-count.
        if (counter) counter.textContent = tpl.replace("{n}", String(total));
      }, LEAD + landed),
    );
  };

  if (fig && !still.matches) {
    fig.classList.add("armed");
    zero();
    fig.querySelector<HTMLButtonElement>("[data-again]")?.addEventListener("click", play);

    // Fires on the way in, and rearms when the figure has fully left, so it plays for
    // someone who scrolls back up, and never twice while it sits on screen.
    let away = true;
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting && away) {
          away = false;
          play();
        } else if (!e.isIntersecting) {
          away = true;
        }
      },
      { threshold: 0.4 },
    ).observe(fig);
  }
</script>

<style>
  /* No max-width: the strips are the hero's evidence and should use the column they are
     given. `.bytes` owns its own overflow.

     One run, not a loop. The 27 cells that carry no information go faint where they
     stand, a copy of each of the 8 that do flies down into the wire strip and inks the
     cell it becomes as it gets there, and the length byte arrives last.

     Nothing here goes dark and stays dark. The shorn cells fade straight to the 0.42 they
     rest at instead of dropping to 0 and being brought back a beat later, which is what
     left the figure illegible for 2.9 of its first 5 seconds.

     Custom properties rather than fixed numbers because the delays are measured at play
     time: the script writes `--wd` on each wire cell and `--in` on the figure, and a class
     change is what runs them. The flights themselves are Web Animations in the script. Everything here is a state
     on top of the resting figure, so with the script never running this is simply the
     static figure. */
  .hero-bytes {
    margin: 0 0 clamp(28px, 4vh, 40px);
    /* Side by side, this bottom margin is the gap between the figure's bottom and the
       row's, and the hero's actions align to the row. Landing.astro cannot reset it from
       outside: Astro scopes with `:where()`, so its `main > figure` rule carries less
       specificity than this class and quietly loses. Stacked, the margin is still the
       separation from whatever follows. */
  }

  @media (min-width: 1240px) {
    .hero-bytes {
      margin-bottom: 0;
    }
  }

  /* One frame with nothing moving, so a replay starts from the resting figure. */
  .hero-bytes.reset *,
  .hero-bytes.reset *::before,
  .hero-bytes.reset *::after {
    transition: none !important;
    animation: none !important;
  }

  /* Pre-play: the wire strip is empty slots waiting for the bytes, and the label above it
     is not there yet: the shorn line has nothing to say until it is shorn. */
  .hero-bytes.armed .wire i {
    color: transparent;
    opacity: 0.42;
  }

  /* `i.len`, not `.len`: the rule above it ends in `i`, so a selector with the same
     class count and no element loses to it, and this one silently did nothing. */
  .hero-bytes.armed .wire i.len {
    opacity: 0;
  }

  .hero-bytes.armed .field,
  .hero-bytes.armed .lane.out {
    opacity: 0;
  }

  /* Staggered by position, so the strip goes faint from the left rather than all at once.
     40 cells at 14ms apart is ~560ms of stagger, finishing while the copies are still in
     the air. Eased rather than linear, so each cell settles into its dim instead of
     stopping on it. */
  .hero-bytes .json i {
    transition: opacity 600ms ease-out;
    transition-delay: calc(var(--i) * 14ms);
  }

  /* Straight to the value they rest at. They used to drop a line's height, rotate, and go
     to opacity 0, then fade back in here 2.7s later, and the figure spent that whole
     stretch as "JSON, 35 bytes" over a void. One destination, no round trip.

     Faint enough to read as removed, solid enough to still read as characters. The one
     knob worth turning by eye. */
  .hero-bytes.playing .tok:not(.run) i {
    opacity: 0.42;
  }

  /* The travelling copy of a survivor: the original stays in the JSON at full ink the
     whole way through, so nothing up there leaves a hole or jumps back. Drawn like the
     cell it copies, so it is indistinguishable from it at both ends of the trip. It
     passes over the divider on the way, hence the stacking context, and `.bytes` is
     what it is positioned against.

     `:global` because the script creates it, so it never gets this file's scope class
     and a scoped `.flier` silently matches nothing. */
  .hero-bytes .bytes {
    position: relative;
  }

  .hero-bytes :global(.flier) {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
    background: var(--shorn-surface);
    color: var(--shorn-ink);
    font-style: normal;
    pointer-events: none;
    will-change: transform;
  }

  /* Each cell inks as its own character gets there, on `--wd`. Inking the strip in one go
     at the end of the run left 1.07s of dead air between the last byte landing (3430ms)
     and the wire lighting up (4500ms), and eight characters in flight over eight empty
     boxes for the second before that. */
  .hero-bytes.armed.playing .wire i {
    color: var(--shorn-ink);
    opacity: 1;
    transition:
      color 160ms ease-out var(--wd, 0ms),
      opacity 160ms ease-out var(--wd, 0ms);
  }

  /* `--in` is the first landing: the shorn line has nothing to say until one byte is on
     it, and everything to say from then on. It used to wait for the whole run. */
  .hero-bytes.armed.playing .field,
  .hero-bytes.armed.playing .lane.out {
    opacity: 1;
    transition: opacity 420ms ease-out var(--in, 880ms);
  }

  /* Held back through `playing`, because the rule that inks the wire progressively also
     matches this cell and it has no `--wd` of its own, so it would light up first instead
     of last. Five classes to that rule's four plus an element. */
  .hero-bytes.armed.playing .wire i.len {
    opacity: 0;
  }

  /* The one byte nothing flew into: the string's length, the whole cost of the format.
     It arrives last, on its own, which is the only way to notice it. `done` is the last
     landing, so it needs no delay of its own.

     It fades and grows in slightly, with no overshoot. The overshoot it used to have was
     the one springy motion in a run that is otherwise all glides, and it read as a jolt
     at the end.

     `i.len` for the same reason as above, and this one was losing its dim ink to the rule
     that inks the wire, so the run ended on a length byte a shade brighter than the one
     the static figure draws. */
  .hero-bytes.armed.done .wire i.len {
    color: var(--shorn-ink-dim-raised);
    animation: settle 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes settle {
    from {
      transform: scale(0.8);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }

  /* Where it comes to rest is now simply where the two rules above leave it: the original
     record with the air in it dimmed to 0.42, the eight surviving characters at full ink
     because those are the ones that are also below, and the wire strip inked. There is no
     third beat that assembles it, which is why there is no `ghost` class here any more. */

  figcaption {
    margin-top: 18px;
    max-width: 62ch;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--shorn-ink-3);
  }

  .gag {
    color: var(--shorn-ink-2);
  }

  /* A button, on its own line under the caption, drawn like the copy button beside the
     install command. It was an underlined "↻ shear it again" run on the end of the
     caption's last sentence, where the glyph read as a stray character and the whole
     thing as more caption. */
  .again {
    display: block;
    margin-top: 14px;
    padding: 7px 14px;
    background: var(--shorn-surface);
    border: 1px solid var(--shorn-rule);
    border-radius: var(--shorn-radius);
    cursor: pointer;
    font-family: var(--mono, ui-monospace), monospace;
    font-size: 12.5px;
    color: var(--shorn-ink);
  }

  .again:hover {
    background: var(--shorn-rule);
  }

  /* The run is decoration on a static figure: it reads the same without it, so the
     button that replays it has nothing to offer either. */
  @media (prefers-reduced-motion: reduce) {
    .again {
      display: none;
    }
  }
</style>
