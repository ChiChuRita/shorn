---
import Default from "@astrojs/starlight/components/Head.astro";
import { getCollection } from "astro:content";

const llmsUrl = `${import.meta.env.BASE_URL}llms.txt`;

// Advertise this page's markdown twin, per llms.txt v2. Derived from the pathname and
// then checked against the real ids, so the 404 route does not claim a twin it has not
// got. It reaches this component like any other page.
const ids = new Set((await getCollection("docs")).map((entry) => entry.id));
const slug = Astro.url.pathname.replace(/^\/+|\/+$/g, "");
const mdUrl = ids.has(slug) ? `${import.meta.env.BASE_URL}${slug}.md` : null;
---

{/* Siblings, not children: Starlight's Head renders `starlightRoute.head` and has no
    slot, so anything passed inside it is dropped without warning. */}
<Default {...Astro.props} />
{/* Cascade layer order is fixed by whichever stylesheet names a layer first, and the
    build links a shared chunk (the Starlight components the landing page imports)
    ahead of Starlight's own CSS. That chunk names `starlight.components` and
    `starlight.content` first, which ranked `starlight.reset` above the content layer
    and zeroed every gap between paragraphs, code blocks, and headings. Astro puts the
    stylesheet links after this, so declaring the order here makes it independent of
    how the chunks are split. Same two statements Starlight and the theme ship. */}
<style is:inline>
  @layer starlight, nextjs;
  @layer starlight.base, starlight.reset, starlight.core, starlight.content, starlight.components, starlight.utils;
</style>
{mdUrl && <link rel="alternate" type="text/markdown" href={mdUrl} title="Markdown" />}
<link rel="alternate" type="text/markdown" href={llmsUrl} title="LLMs.txt" />
<script is:inline>
  // Dark-only docs: pin the Starlight theme before its ThemeProvider reads it.
  localStorage.setItem("starlight-theme", "dark");
  document.documentElement.dataset.theme = "dark";
</script>
